# Copy this file to .env in the same folder, then fill in your token.
# The web UI does not take a token — restart the app after you save .env.

# Sign in at https://q.utoronto.ca → Account → Settings → New Access Token.

QUERCUS_CANVAS_URL=https://q.utoronto.ca
QUERCUS_TOKEN=
QUERCUS_DOWNLOAD_DIR=downloads
